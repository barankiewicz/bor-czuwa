{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*.ts", "src/lib/report.ts", "tests/**/*.ts", "playwright.config.ts", "ops/**/*.ts"]
}
